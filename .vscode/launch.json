    "version": "0.2.0",
    "configurations": [    
        {
            "name": "Launch",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/src/main.go",
            "env": {
                "ENVSENSOR_MQTT_HOST": "localhost",
                "ENVSENSOR_MQTT_PORT": "1883",
                "ENVSENSOR_MQTT_USERNAME": "admin",
                "ENVSENSOR_MQTT_PASSWORD": "public",
                "ENVSENSOR_MQTT_USETLS": "false",
                "ENVSENSOR_BME280_ADDRESS": "0x77",
                "USE_MOCK": "true"
            },
            "args": []
        }
    ]
}